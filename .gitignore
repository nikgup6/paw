# Secrets. Applies at every depth: root, backend/ and frontend/.
# .env.example is the one env file that SHOULD be committed - placeholders only.
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output - rebuilt from package.json / requirements.txt
node_modules/
dist/
dist-ssr/
.vite/
coverage/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Logs and editor noise
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
