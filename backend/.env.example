# --- Required: the backend will not start without these two ---------------------
# NEVER put real values in this file - it is committed. Copy it to backend/.env
# (git-ignored) and fill them in there, or set them in the host's env settings.
#
# MongoDB Atlas connection string: Atlas -> Database -> Connect -> Drivers.
# Shape: mongodb+srv://<user>:<password>@<cluster-host>/?appName=pawBuddy
MONGODB_URI=
# Token-signing key. Generate one with:  python scripts/gen_secret.py
# Use a different key on your laptop and on the live server.
SECRET_KEY=

# dev on your laptop, production on the live server. Production refuses to start
# with a SECRET_KEY under 32 characters or one that looks like a placeholder.
ENV=dev

# How many days an ordinary visitor's sign-in lasts (the token is their account).
USER_TOKEN_DAYS=30

# Websites allowed to call this API from a browser: exact origins, comma
# separated, no wildcard, no trailing slash. Live: your real frontend address(es).
CORS_ORIGINS=http://localhost:5173

# Proxies in front of the API that append to X-Forwarded-For. 0 on a laptop,
# 1 on Vercel. Decides whose address the rate limits count against.
TRUSTED_PROXY_COUNT=0

# Paid AI matchmaker calls per day across all visitors; then the free fallback.
MATCHMAKER_DAILY_CAP=300

# --- Paywall -------------------------------------------------------------------
# off | fake_door (pilot default: shows the price, takes NO money) | test | live
PAYWALL_MODE=fake_door
# Price in paise (9900 = Rs 99) and how long one payment unlocks full matches.
PAYWALL_PRICE_PAISE=9900
PAYWALL_UNLOCK_DAYS=30

# Pilot dashboard (admin Funnel page -> Pilot tab). Dates are inclusive.
PILOT_START=2026-10-20
PILOT_END=2026-11-09
PILOT_TARGET_SIGNUPS=150
# Leave blank until you pick one; the dashboard will say "set a target".
PILOT_TARGET_PAYERS=
PILOT_PRICE_PAISE=9900
# Your own / your team's test numbers, comma separated. Left out of the pilot numbers.
INTERNAL_TEST_MOBILES=

# TEMPORARY - delete this and POST /api/auth/legacy-login when OTP is live.
# Numbers allowed to sign in by number alone (existing dog owners only), comma
# separated. Anyone who knows one of these numbers can open that person's dog
# records, so keep it to the team's own numbers. Blank = nobody.
LEGACY_MOBILE_LOGIN_ALLOWLIST=
# Razorpay Dashboard -> Account & Settings -> API Keys. Test keys start rzp_test_,
# live keys rzp_live_; the mode refuses the wrong kind. The KEY ID is public; the
# secret must never be put in frontend code or a VITE_ variable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks: the secret you choose when adding
# https://<your-backend>/api/paywall/webhook (events: payment.captured,
# order.paid, payment.failed). Required for live.
RAZORPAY_WEBHOOK_SECRET=
# Admin demo payments. With PAYWALL_MODE=live, ADMIN accounts pay through these
# Razorpay TEST keys (no real money); every other account pays live. Blank =
# admins pay live too. The test webhook secret is optional (verify alone unlocks).
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
# Days an admin demo payment unlocks for (default 1). The admin panel's
# "Cancel subscription" ends it sooner.
# ADMIN_DEMO_UNLOCK_DAYS=1

# Copy to .env and fill in. The AI Matchmaker uses Claude (Haiku 4.5) to parse
# natural-language prompts. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Cloudinary — stores uploaded vaccination documents.
# Get these from your Cloudinary dashboard (https://cloudinary.com/console).
# Leave blank until you have real values: a placeholder here would look "configured"
# and uploads would fail, instead of saying storage is not set up.
# Option A — three separate values:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Option B — a single URL instead of the three above (leave the three blank):
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Optional: where files are stored inside Cloudinary
CLOUDINARY_UPLOAD_FOLDER=paw_buddy/vaccination_records

# AI processing (Health Vault). Provider-agnostic — pick one:
#   AI_PROVIDER=gemini | openai | anthropic   (default gemini)
AI_PROVIDER=gemini
# Confidence a record needs to auto-create a reminder; below this → Needs Review.
AI_AUTO_REMINDER_THRESHOLD=0.8

# Google Gemini (default provider). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (only if AI_PROVIDER=openai; needs `pip install openai`)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Anthropic/Claude (only if AI_PROVIDER=anthropic; uses ANTHROPIC_API_KEY above)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Boot-time database setup -------------------------------------------------
# Indexes + readiness seed + legacy-tier migration. Idempotent, so running them
# every boot is harmless on a long-lived server — but on serverless (Vercel)
# every COLD START repeats them before the first request is answered, which
# measured at ~6s against Atlas. Set this false in the Vercel project's env and
# run `python init_db.py` once per deploy instead.
# Laptop: true (or leave out). Vercel: false.
RUN_STARTUP_MIGRATIONS=true

# --- Optional -------------------------------------------------------------------
# Weather on the dog dashboard. Blank = the card uses the climate-zone estimate.
WEATHER_API_KEY=
WEATHER_API_PROVIDER=openweathermap
