# Copy to frontend/.env.local on a laptop (git-ignored). On Vercel, set it in the
# FRONTEND project -> Settings -> Environment Variables, then redeploy: Vite bakes
# it into the site at build time.
#
# The backend's address, no trailing slash. The site sends sign-in tokens ONLY to
# this exact address.
#   Laptop: http://localhost:8000
#   Vercel: https://<your-backend-project>.vercel.app  (or your API domain)
VITE_API_URL=http://localhost:8000
